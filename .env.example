# ── Application ───────────────────────────────────────────────
APP_NAME="Sergio Troche Portfolio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_LOCALE=es

# ── Logging ───────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# ── Database (not actively used — portfolio is static) ────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=serguicv
DB_USERNAME=root
DB_PASSWORD=

# ── Cache / Session ───────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── Mail ──────────────────────────────────────────────────────
# Gmail SMTP setup:
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to Security → App passwords → Create one for "Mail"
# 3. Use the generated 16-char password as MAIL_PASSWORD
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your@gmail.com
MAIL_FROM_NAME="Sergio Troche Portfolio"
MAIL_PORTFOLIO_RECIPIENT=sergio.denis.troche.mayta@gmail.com
# Receptor de la captura de leads (/leads). Si se omite, usa MAIL_PORTFOLIO_RECIPIENT.
MAIL_LEAD_RECIPIENT=sergio.denis.troche.mayta@gmail.com

# ── Redis (page cache 120 min · contadores de vistas/descargas) ───
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# ── Flags / observabilidad ────────────────────────────────────
# "Open to work" visible en el hero (true|false)
OPEN_TO_WORK=true
# DSN de Sentry para reporte de errores (opcional — vacío = deshabilitado)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_RATE=0.1

# ── URLs del ecosistema Kapitalya (widget FX + /status) ───────
# Tromay — tasas USD/BOB en vivo (widget FX) + /status Grupo A
TROMAY_INTERNAL_URL=http://tromay_app:80
TROMAY_URL=https://tromay.kapitalya.com.bo
# Enlaces de proyectos + /status Grupo A
FINDEMPROAI_URL=https://app.kapitalya.com.bo
FINDEMPROLAREOS_URL=https://lacteos.kapitalya.com.bo
FOREX_URL=https://forex.kapitalya.com.bo
ALERTAS_URL=https://alertas.kapitalya.com.bo
# /status Grupo B — servicios ML/FastAPI (vía gateway público)
FOREX_PRED_URL=https://bolivian-forex.kapitalya.com.bo
ANALYTICS_URL=https://analytics.kapitalya.com.bo
ASFI_URL=https://asfi.kapitalya.com.bo
MARKET_MAKER_URL=https://market-maker.kapitalya.com.bo
KYC_URL=https://kyc.kapitalya.com.bo
LLM_URL=https://llm.kapitalya.com.bo
FRAUD_URL=https://fraud.kapitalya.com.bo
ML_TS_URL=https://ml.kapitalya.com.bo
AIRFLOW_URL=https://airflow.kapitalya.com.bo

# Vistas (sandbox de API + lead-modal + dashboard en vivo) — opcionales
EXCHANGE_ALERT_URL=https://alertas.kapitalya.com.bo
FOREX_PREDICTOR_URL=https://predictor.kapitalya.com.bo
INSIGHTS_URL=https://insights.kapitalya.com.bo
FOREX_ERP_URL=https://forex.kapitalya.com.bo

# ── Captura de leads → kapitalya-admin (opcional) ─────────────
KAPITALYA_ADMIN_URL=http://kapitalya-admin.kapitalya.svc.cluster.local:8008
KAPITALYA_ADMIN_TOKEN=

# ── Monetización — anuncios (AdSense) y analítica (opcional) ──
# Vacío = desactivado (sin scripts de terceros, CSP estricto, sin banner).
# En un CV/portafolio conviene activar SOLO GA (medición), no AdSense.
ADSENSE_CLIENT=          # ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_SLOT=            # bloque display responsive (opcional)
GA_MEASUREMENT_ID=       # G-XXXXXXXXXX (Google Analytics 4, opcional)
